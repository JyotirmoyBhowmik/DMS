{
  "version": 2,
  "name": "dms-web-admin",
  "buildCommand": "cd ../.. && npm install -g pnpm@8.15.4 && pnpm install && pnpm --filter @dms/pkg-ui-shared run build && pnpm --filter @dms/web-admin run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
