# 7. VERCEL REST API INTEGRATION (Rule 3.1)
# ==============================================================================
class VercelApiClient:
    """Client for triggering deployments and managing Environment Variables on Vercel."""
    
    def __init__(self, config: VercelConfig):
        self.config = config
        self.base_url = "https://api.vercel.com"
        self.headers = {
            "Authorization": f"Bearer {config.token}",
            "Content-Type": "application/json"
        }
        self.timeout = (5.0, 20.0)  # 5s connect, 20s read timeout (Rule 3.1)

    @retry_with_backoff(max_retries=3)
    def _api_request(self, method: str, endpoint: str, body: Optional[dict] = None, params: Optional[dict] = None) -> dict:
        url = f"{self.base_url}{endpoint}"
        query_params = params or {}
        if self.config.team_id:
            query_params["teamId"] = self.config.team_id

        try:
            response = requests.request(
                method=method,
                url=url,
                headers=self.headers,
                json=body,
                params=query_params,
                timeout=self.timeout
            )
            
            # Capture error details securely without leaking core stack traces (Rule 2.4)
            if response.status_code >= 400:
                err_msg = f"HTTP Error {response.status_code}: {response.text}"
                try:
                    data = response.json()
                    err_msg = data.get("error", {}).get("message", err_msg)
                except Exception:
                    pass
                raise VercelApiError(err_msg, details={"status_code": response.status_code})
                
            return response.json() if response.content else {}
        except requests.exceptions.RequestException as e:
            raise VercelApiError(f"HTTP request to Vercel API failed: {endpoint}", details={"error": str(e)})

    def get_project_details(self) -> dict:
        """Retrieves info on the target Vercel project."""
        return self._api_request("GET", f"/v9/projects/{self.config.project_id}")

    def list_env_variables(self) -> List[dict]:
        """Lists active Environment Variables for the configured project."""
        res = self._api_request("GET", f"/v9/projects/{self.config.project_id}/env")
        return res.get("envs", [])

    def upsert_env_variable(self, key: str, value: str, target: Optional[List[str]] = None) -> dict:
        """Creates or updates a Vercel project environment variable."""
        if not key or not re.match(r"^[A-Z_][A-Z0-9_]*$", key):
            raise ValidationError(f"Invalid environment variable naming syntax: {key}")
        if target is None:
            target = ["production", "preview", "development"]

        envs = self.list_env_variables()
        matched_env = next((e for e in envs if e.get("key") == key), None)

        body = {
            "key": key,
            "value": value,
            "type": "secret" if any(k in key.lower() for k in ["secret", "password", "token", "key"]) else "plain",
            "target": target
        }

        if matched_env:
            env_id = matched_env["id"]
            logger.info(f"Environment variable '{key}' already exists. Patching value...")
            return self._api_request("PATCH", f"/v9/projects/{self.config.project_id}/env/{env_id}", body=body)
        else:
            logger.info(f"Creating new environment variable '{key}'...")
            return self._api_request("POST", f"/v9/projects/{self.config.project_id}/env", body=body)

    @retry_with_backoff(max_retries=3)
    def trigger_deploy_hook(self, hook_url: str) -> dict:
        """Triggers a project rebuild via a Vercel Deploy Hook."""
        parsed = urllib.parse.urlparse(hook_url)
        if parsed.scheme != "https" or "vercel.com" not in parsed.netloc:
            raise ValidationError("Invalid Deploy Hook URL. Must be an https URL targeting vercel.com.")
            
        try:
            logger.info("Triggering Vercel deployment rebuild...")
            response = requests.post(hook_url, timeout=self.timeout)
            if response.status_code >= 400:
                raise VercelApiError(f"Deploy hook returned error: {response.status_code}", details={"body": response.text})
            return response.json()
        except requests.exceptions.RequestException as e:
            raise VercelApiError("Failed to trigger Vercel deployment hook", details={"error": str(e)})


# ==============================================================================
# 8. ORCHESTRATION PIPELINE
# ==============================================================================
def run_orchestrated_pipeline(
    oci_config: OciConfig, 
    vercel_config: VercelConfig,
    oci_compartment_id: str,
    db_credentials: Optional[dict] = None,
    deploy_hook_url: Optional[str] = None
):
    """
    Coordinates data fetched from OCI, pushes state updates to Vercel env vars,
    and runs a project redeployment trigger.
    """
    logger.info("Initializing connection and boundary validations...")
    oci_config.validate()
    vercel_config.validate()
    
    # 1. Access OCI Resources safely
    logger.info("Accessing Oracle Cloud Infrastructure...")
    with oci_config_manager(oci_config) as raw_oci_cfg:
        storage_client = OciObjectStorageClient(raw_oci_cfg)
        
        # Test basic Object Storage connectivity
        buckets = storage_client.list_buckets(oci_compartment_id)
        logger.info(f"Successfully connected to OCI Object Storage. Compartment contains {len(buckets)} buckets.", extra={"buckets": buckets})

    # 2. Query DB if details are provided
    if db_credentials:
        logger.info("Connecting to Oracle Database in Thin Mode...")
        db_client = OracleDbClient(
            user=db_credentials["user"],
            password=db_credentials["password"],
            dsn=db_credentials["dsn"]
        )
        # Execute query safely limiting row returns
        query = "SELECT COUNT(*) AS total_rows FROM user_tables"
        results = db_client.query_records(query, limit=5)
        logger.info("Successfully fetched database metadata from Oracle Cloud.", extra={"results": results})
        
        # Prepare mock string from results to feed into Vercel config
        db_metadata_val = f"TotalTables={results[0].get('TOTAL_ROWS', 0)}"
    else:
        db_metadata_val = "NotConfigured"

    # 3. Synchronize Vercel parameters
    logger.info("Connecting to Vercel API...")
    vercel_client = VercelApiClient(vercel_config)
    
    # Verify project exists
    details = vercel_client.get_project_details()
    logger.info(f"Verified Vercel project: {details.get('name')} (id: {details.get('id')})")
    
    # Upsert a state config variable
    sync_key = "OCI_SYNC_STATUS"
    sync_val = f"last_updated={datetime.datetime.utcnow().isoformat()};{db_metadata_val}"
    vercel_client.upsert_env_variable(sync_key, sync_val)
    logger.info(f"Successfully upserted environment variable '{sync_key}' on Vercel.")

    # 4. Trigger deployment build hook if configured
    if deploy_hook_url:
        hook_response = vercel_client.trigger_deploy_hook(deploy_hook_url)
        logger.info("Vercel deployment successfully triggered.", extra={"job": hook_response.get("job")})
        
    logger.info("OCI-Vercel orchestration pipeline completed successfully!")


