# 6. OCI SERVICE INTEGRATIONS (Rule 5.1, 5.3)
# ==============================================================================
@contextlib.contextmanager
def oci_config_manager(oci_cfg: OciConfig):
    """Context manager for secure, deterministic generation and cleanup of OCI key files."""
    temp_key_file = tempfile.NamedTemporaryFile(mode="w", delete=False)
    try:
        temp_key_file.write(oci_cfg.private_key_content.strip() + "\n")
        temp_key_file.close()
        
        config = {
            "user": oci_cfg.user,
            "key_file": temp_key_file.name,
            "fingerprint": oci_cfg.fingerprint,
            "tenancy": oci_cfg.tenancy,
            "region": oci_cfg.region
        }
        
        # Verify schema internally via OCI SDK
        oci.config.validate_config_dict(config)
        yield config
    except Exception as e:
        raise OciConnectionError("Could not initialize OCI credentials structure", details={"original_error": str(e)})
    finally:
        # Deterministic deletion of secret PEM file
        if os.path.exists(temp_key_file.name):
            try:
                os.remove(temp_key_file.name)
            except Exception as e:
                # Fail-safe print in case file removal fails
                print(f"FAILED TO REMOVE TEMP KEY FILE {temp_key_file.name}: {e}", file=sys.stderr)


class OciObjectStorageClient:
    """Client helper for OCI Object Storage operations."""
    
    def __init__(self, config: dict):
        self.config = config
        try:
            self.client = oci.object_storage.ObjectStorageClient(config)
        except Exception as e:
            raise OciConnectionError("Failed to initialize Object Storage SDK Client", details={"original_error": str(e)})

    @retry_with_backoff(max_retries=3)
    def list_buckets(self, compartment_id: str) -> List[str]:
        """Lists bucket names inside a compartment."""
        if not compartment_id or not compartment_id.startswith("ocid1.compartment."):
            raise ValidationError("Invalid Compartment OCID format.")
        try:
            namespace = self.client.get_namespace().data
            buckets = self.client.list_buckets(namespace, compartment_id).data
            return [b.name for b in buckets]
        except Exception as e:
            raise OciConnectionError(f"Failed to list buckets in compartment {compartment_id}", details={"original_error": str(e)})

    @retry_with_backoff(max_retries=3)
    def download_object(self, bucket_name: str, object_name: str, dest_path: str):
        """Downloads an object from the bucket with strict block management."""
        if not bucket_name or not object_name:
            raise ValidationError("Bucket and Object names are required inputs.")
        try:
            namespace = self.client.get_namespace().data
            response = self.client.get_object(namespace, bucket_name, object_name)
            
            with open(dest_path, "wb") as f:
                for chunk in response.data.raw.stream(1024 * 1024, decode_content=False):
                    f.write(chunk)
        except Exception as e:
            raise OciConnectionError(f"Object download failed: {object_name} from {bucket_name}", details={"original_error": str(e)})


class OracleDbClient:
    """Oracle Database client operating in thin mode (requires zero local instant client binaries)."""
    
    def __init__(self, user: str, password: str, dsn: str):
        if not user or not password or not dsn:
            raise ValidationError("Database username, password, and connection string (DSN) are mandatory.")
        self.user = user
        self.password = password
        self.dsn = dsn

    @retry_with_backoff(max_retries=3)
    def query_records(self, query: str, params: Optional[dict] = None, limit: int = 100) -> List[Dict[str, Any]]:
        """Executes a secure SELECT query with pagination enforcement (Rule 5.2)."""
        if not query.strip().upper().startswith("SELECT"):
            raise ValidationError("Only read-only SELECT statements are supported by this client handler.")
        
        connection = None
        cursor = None
        try:
            # Thin mode execution is native to oracle-oracledb
            connection = oracledb.connect(user=self.user, password=self.password, dsn=self.dsn)
            cursor = connection.cursor()
            
            # Bound parameter execution prevents SQL Injection (Rule 1.4)
            cursor.execute(query, params or {})
            columns = [col[0] for col in cursor.description]
            
            # Fetch up to the specified safety boundary limit
            rows = cursor.fetchmany(limit)
            return [dict(zip(columns, row)) for row in rows]
        except Exception as e:
            raise OciConnectionError("Database query failed to execute", details={"original_error": str(e)})
        finally:
            # Deterministic connection cleanup (Rule 5.1)
            if cursor:
                try:
                    cursor.close()
                except Exception:
                    pass
            if connection:
                try:
                    connection.close()
                except Exception:
                    pass


