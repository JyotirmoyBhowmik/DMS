# 2. STRUCTURED LOGGING & SECURITY (Rule 4.1, 4.3)
# ==============================================================================
class StructuredLogger:
    """Enterprise JSON structured logger with automatic PII and secret redaction."""
    
    def __init__(self, service_name: str = "OCI-Vercel-Colab"):
        self.service_name = service_name
        self.redact_keys = {"token", "key", "password", "secret", "auth", "fingerprint", "private_key"}

    def _redact_value(self, key: str, value: Any) -> Any:
        if not isinstance(key, str):
            return value
        if any(redact_k in key.lower() for redact_k in self.redact_keys):
            return "[REDACTED]"
        return value

    def _redact_dict(self, d: dict) -> dict:
        if not isinstance(d, dict):
            return d
        return {k: (self._redact_dict(v) if isinstance(v, dict) else self._redact_value(k, v)) for k, v in d.items()}

    def _log(self, level: str, message: str, extra: Optional[dict] = None, exc_info: Optional[Exception] = None):
        log_data = {
            "timestamp": datetime.datetime.utcnow().isoformat() + "Z",
            "level": level,
            "service_name": self.service_name,
            "message": message,
        }
        if extra:
            log_data["extra"] = self._redact_dict(extra)
        
        if exc_info:
            log_data["error"] = {
                "type": type(exc_info).__name__,
                "message": str(exc_info)
            }
            
        print(json.dumps(log_data), file=sys.stdout)
        sys.stdout.flush()

    def info(self, message: str, extra: Optional[dict] = None):
        self._log("INFO", message, extra)

    def warn(self, message: str, extra: Optional[dict] = None):
        self._log("WARN", message, extra)

    def error(self, message: str, exc_info: Optional[Exception] = None, extra: Optional[dict] = None):
        self._log("ERROR", message, extra, exc_info)

logger = StructuredLogger()


