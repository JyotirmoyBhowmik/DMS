# 4. CONFIGURATION SCHEMAS & INPUT VALIDATION (Rule 1.1, 1.2, 1.3)
# ==============================================================================
@dataclasses.dataclass
class OciConfig:
    tenancy: str
    user: str
    fingerprint: str
    private_key_content: str
    region: str

    def validate(self):
        """Strict validation of OCI configuration attributes."""
        if not self.tenancy or not self.tenancy.startswith("ocid1.tenancy."):
            raise ValidationError("Invalid OCI Tenancy OCID format. Must start with 'ocid1.tenancy.'")
        if not self.user or not self.user.startswith("ocid1.user."):
            raise ValidationError("Invalid OCI User OCID format. Must start with 'ocid1.user.'")
        if not self.fingerprint or not re.match(r"^([0-9a-fA-F]{2}:){15}[0-9a-fA-F]{2}$", self.fingerprint):
            raise ValidationError("Invalid OCI Fingerprint format. Must be a colon-separated 16-pair hex string.")
        if not self.private_key_content or "PRIVATE KEY" not in self.private_key_content:
            raise ValidationError("Invalid OCI Private Key format. Must be standard PEM block format.")
        if not self.region or len(self.region.strip()) < 3:
            raise ValidationError("Invalid OCI Region specification.")

@dataclasses.dataclass
class VercelConfig:
    token: str
    project_id: str
    team_id: Optional[str] = None

    def validate(self):
        """Strict validation of Vercel API credentials."""
        if not self.token or len(self.token.strip()) < 10:
            raise ValidationError("Invalid Vercel API token. Must be a non-empty string of suitable length.")
        if not self.project_id or len(self.project_id.strip()) < 3:
            raise ValidationError("Invalid Vercel Project ID or Slug.")


# ==============================================================================
# 5. TRANSIENT FAULT TOLERANCE (Rule 3.2, 3.3)
# ==============================================================================
def retry_with_backoff(max_retries: int = 3, initial_delay: float = 1.0, factor: float = 2.0, jitter: bool = True):
    """Resilient wrapper applying Exponential Backoff with Jitter for transient errors."""
    def decorator(func):
        def wrapper(*args, **kwargs):
            delay = initial_delay
            last_exception = None
            for attempt in range(1, max_retries + 1):
                try:
                    return func(*args, **kwargs)
                except Exception as e:
                    last_exception = e
                    # Avoid retrying validation errors or strict credential issues
                    if isinstance(e, ValidationError):
                        raise e
                    
                    if attempt == max_retries:
                        break
                    
                    sleep_time = delay
                    if jitter:
                        sleep_time += random.uniform(0, 0.5 * delay)
                        
                    logger.warn(
                        f"Transient fault detected in {func.__name__}. Retrying in {sleep_time:.2f}s...",
                        extra={"attempt": attempt, "max_retries": max_retries, "error": str(e)}
                    )
                    time.sleep(sleep_time)
                    delay *= factor
            raise last_exception
        return wrapper
    return decorator


