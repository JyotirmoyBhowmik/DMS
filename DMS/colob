def prompt_credentials_and_run():
    """Interactively prompts the user in Google Colab for configuration details to execute."""
    print("=== OCI & Vercel Integration Setup ===")
    print("Please input credentials below. Press Enter to skip optional parameters.\n")
    
    # 1. OCI Credentials
    print("--- OCI Configuration ---")
    tenancy = input("Enter OCI Tenancy OCID (e.g. ocid1.tenancy.oc1...): ").strip()
    user = input("Enter OCI User OCID (e.g. ocid1.user.oc1...): ").strip()
    fingerprint = input("Enter OCI Fingerprint: ").strip()
    region = input("Enter OCI Region (e.g. us-ashburn-1): ").strip()
    compartment_id = input("Enter Compartment OCID (for testing bucket listing): ").strip()
    
    print("Enter OCI Private Key content (press Enter twice on empty line to finish):")
    private_key_lines = []
    while True:
        line = input()
        if not line and (not private_key_lines or not private_key_lines[-1]):
            break
        private_key_lines.append(line)
    private_key_content = "\n".join(private_key_lines).strip()
    
    # 2. Oracle Database (Optional)
    print("\n--- Oracle DB configuration (Optional) ---")
    db_user = input("Enter Database User: ").strip()
    db_password = getpass.getpass("Enter Database Password: ") if db_user else ""
    db_dsn = input("Enter DSN (Connection String): ").strip() if db_user else ""
    
    db_creds = None
    if db_user and db_password and db_dsn:
        db_creds = {"user": db_user, "password": db_password, "dsn": db_dsn}

    # 3. Vercel Credentials
    print("\n--- Vercel Configuration ---")
    vercel_token = getpass.getpass("Enter Vercel Personal API Token: ").strip()
    vercel_project = input("Enter Vercel Project ID or Slug: ").strip()
    vercel_team = input("Enter Vercel Team ID (Optional): ").strip() or None
    deploy_hook = input("Enter Vercel Deploy Hook URL (Optional): ").strip() or None

    try:
        oci_cfg = OciConfig(
            tenancy=tenancy,
            user=user,
            fingerprint=fingerprint,
            private_key_content=private_key_content,
            region=region
        )
        vercel_cfg = VercelConfig(
            token=vercel_token,
            project_id=vercel_project,
            team_id=vercel_team
        )
        
        run_orchestrated_pipeline(
            oci_config=oci_cfg,
            vercel_config=vercel_cfg,
            oci_compartment_id=compartment_id,
            db_credentials=db_creds,
            deploy_hook_url=deploy_hook
        )
    except AppError as ae:
        logger.error(f"Pipeline Execution Failed: {ae.message}", exc_info=ae, extra=ae.details)
    except Exception as e:
        logger.error("An unexpected system exception occurred during execution", exc_info=e)


